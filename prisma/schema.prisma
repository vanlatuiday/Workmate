// Mô hình dữ liệu Workmate — xem docs/data-model.md (bản dễ đọc).
// Khóa của mọi thứ về "kết nối" là cặp (jobId, seekerId); seekerId = SeekerProfile.userId.
// Id dạng chuỗi để dữ liệu mẫu giữ được id cũ của frontend (m1, j1, u1…).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Tài khoản ─────────────────────────

enum Role {
  jobseeker
  recruiter
  admin
}

enum UserStatus {
  active
  locked
}

enum Visibility {
  public
  connected
  hidden
}

enum EmailDigest {
  instant
  daily
  off
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  /// Tên đăng nhập ngắn (tài khoản demo: admin1…); đăng ký mới dùng email
  username     String?    @unique
  passwordHash String
  role         Role
  status       UserStatus @default(active)
  /// Tăng khi đổi/đặt lại mật khẩu: mọi token cũ mất hiệu lực
  tokenVersion Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  seeker         SeekerProfile?
  memberships    CompanyMember[]
  settings       UserSettings?
  passwordResets PasswordReset[]
  notifications  Notification[]
  postedJobs     Job[]              @relation("JobAuthor")
  reads          ConversationRead[]
  reports        Report[]
  candidateMarks CandidateMark[]
}

/// Đăng ký đang chờ xác nhận email. Tài khoản chỉ được tạo sau khi nhập đúng mã,
/// nên email giả không sinh ra tài khoản hay công ty rỗng và không ai chiếm trước được email của người khác.
model PendingRegistration {
  email        String   @id
  passwordHash String
  role         Role
  name         String
  codeHash     String
  /// Số lần nhập sai mã (tối đa 5 thì hủy)
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  /// Số lần nhập sai mã (tối đa 5 thì mã bị hủy)
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSettings {
  userId      String      @id
  /// Loại thông báo đang tắt: { "interest": false, … } — thiếu khóa = bật
  notify      Json        @default("{}")
  emailDigest EmailDigest @default(daily)
  visibility  Visibility  @default(public)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Người tìm việc ─────────────────────────

enum JobType {
  full_time @map("full-time")
  part_time @map("part-time")
  shift
  seasonal
  flexible
  event
  freelance
}

model SeekerProfile {
  userId        String    @id
  fullName      String
  phone         String    @default("")
  avatarUrl     String?
  showAvatar    Boolean   @default(true)
  /// Câu giới thiệu ngắn (1–2 câu)
  intro         String    @default("")
  /// "Về bạn" — đoạn dài
  about         String    @default("")
  /// Khu vực hiển thị, vd. "Hải Châu, Đà Nẵng"
  area          String    @default("")
  lat           Float?
  lng           Float?
  /// Lương tối thiểu, nghìn đồng/giờ
  salaryMinK    Int       @default(25)
  maxDistanceKm Int       @default(5)
  jobTypes      JobType[]
  skills        String[]
  /// Ô lịch rảnh dạng "ngày-buổi" (ngày 0–6 = T2…CN, buổi 0–2 = sáng/chiều/tối)
  availability  String[]
  /// Ngày bắt đầu đi làm được; null = có thể bắt đầu ngay
  availableFrom DateTime? @db.Date
  published     Boolean   @default(false)
  updatedAt     DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences   SeekerExperience[]
  cvs           Cv[]
  savedJobs     SavedJob[]
  interests     Interest[]
  connections   Connection[]
  messages      Message[]
  interviews    Interview[]
  hires         Hire[]
  reviews       Review[]
  marks         CandidateMark[]
  reads         ConversationRead[]
  notifications Notification[]
}

model SeekerExperience {
  id       String        @id @default(cuid())
  seekerId String
  title    String
  company  String
  /// Thời gian dạng chữ như frontend đang nhập, vd. "06/2025 – 01/2026"
  period   String        @default("")
  order    Int           @default(0)
  seeker   SeekerProfile @relation(fields: [seekerId], references: [userId], onDelete: Cascade)

  @@index([seekerId])
}

model Cv {
  id         String        @id @default(cuid())
  seekerId   String
  name       String
  /// Khóa file trên kho lưu trữ (R2)
  fileKey    String
  mimeType   String
  size       Int
  isDefault  Boolean       @default(false)
  uploadedAt DateTime      @default(now())
  seeker     SeekerProfile @relation(fields: [seekerId], references: [userId], onDelete: Cascade)

  @@index([seekerId])
}

// ───────────────────────── Doanh nghiệp & tin ─────────────────────────

enum CompanySize {
  s1_10    @map("1-10")
  s11_50   @map("11-50")
  s51_200  @map("51-200")
  s201_500 @map("201-500")
  s500p    @map("500+")
}

model Company {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  industry    String      @default("")
  district    String      @default("")
  address     String      @default("")
  lat         Float?
  lng         Float?
  size        CompanySize @default(s1_10)
  tagline     String      @default("")
  about       String      @default("")
  environment String[]
  values      String[]
  policies    String[]
  culture     String      @default("")
  email       String      @default("")
  phone       String      @default("")
  logoUrl     String?
  /// Ảnh bìa: id ảnh Unsplash (như frontend) hoặc URL đã tải lên
  coverPhoto  Json?
  verified    Boolean     @default(false)
  locked      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  members       CompanyMember[]
  jobs          Job[]
  verifications CompanyVerification[]
}

enum VerificationStatus {
  pending
  approved
  rejected
}

/// Một lần doanh nghiệp gửi giấy tờ xin xác minh; admin duyệt hoặc từ chối kèm lý do.
/// Company.verified vẫn là cờ hiệu lực (admin có thể gỡ sau khi đã duyệt).
model CompanyVerification {
  id            String                 @id @default(cuid())
  companyId     String
  status        VerificationStatus     @default(pending)
  /// Ghi chú của doanh nghiệp gửi kèm
  note          String                 @default("")
  rejectReason  String?
  submittedById String?
  reviewedById  String?
  submittedAt   DateTime               @default(now())
  reviewedAt    DateTime?
  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents     VerificationDocument[]

  @@index([companyId, submittedAt])
  @@index([status, submittedAt])
}

/// Giấy tờ đính kèm (bucket riêng tư, chỉ admin xem qua link ký tạm thời)
model VerificationDocument {
  id             String              @id @default(cuid())
  verificationId String
  name           String
  fileKey        String
  mimeType       String
  size           Int
  verification   CompanyVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId])
}

enum MemberRole {
  owner
  member
}

model CompanyMember {
  companyId String
  userId    String
  role      MemberRole @default(owner)
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([companyId, userId])
  @@index([userId])
}

enum JobStatus {
  open
  paused
  closed
}

enum ModerationStatus {
  pending
  approved
  rejected
  /// Quản trị viên ẩn một tin đã duyệt
  hidden
}

model Job {
  id               String           @id @default(cuid())
  companyId        String
  authorId         String?
  title            String
  description      String           @default("")
  jobType          JobType
  district         String           @default("")
  address          String           @default("")
  lat              Float?
  lng              Float?
  salaryMinK       Int
  salaryMaxK       Int
  /// Nhãn hiển thị, vd. "28.000–32.000đ/giờ" hoặc "350.000đ/ngày"
  salaryLabel      String
  shiftLabel       String           @default("")
  /// Ca làm, cùng kiểu ô với lịch rảnh
  slots            String[]
  skills           String[]
  /// Kỹ năng bắt buộc (nằm trong skills): ứng viên thiếu thì không được tính là phù hợp
  requiredSkills   String[]         @default([])
  /// Ứng viên phải rảnh đủ mọi ca của tin
  requireAllSlots  Boolean          @default(false)
  quantity         Int              @default(1)
  radiusKm         Int              @default(8)
  /// Ảnh minh họa { id, alt } (Unsplash) hoặc { url, alt }
  photo            Json
  status           JobStatus        @default(open)
  moderation       ModerationStatus @default(pending)
  moderationReason String?
  moderatedAt      DateTime?
  postedAt         DateTime         @default(now())
  expiresAt        DateTime?
  /// Lượt xem trang chi tiết (mỗi người xem tính tối đa 1 lần/ngày, không tính người trong công ty và admin)
  viewCount        Int              @default(0)
  updatedAt        DateTime         @updatedAt

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author        User?              @relation("JobAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  savedBy       SavedJob[]
  interests     Interest[]
  connections   Connection[]
  messages      Message[]
  interviews    Interview[]
  hires         Hire[]
  reviews       Review[]
  marks         CandidateMark[]
  reads         ConversationRead[]
  notifications Notification[]
  views         JobView[]

  @@index([companyId])
  @@index([status, moderation])
}

/// Chống đếm trùng lượt xem trong ngày (giờ Việt Nam). Chỉ giữ vài ngày gần nhất, JobViewService dọn dần.
model JobView {
  jobId     String
  /// "u:<userId>" hoặc "ip:<băm IP>" với khách
  viewerKey String
  day       DateTime @db.Date
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([jobId, viewerKey, day])
  @@index([day])
}

// ───────────────────────── Kết nối hai chiều ─────────────────────────

/// Phía hành động: seeker = người tìm việc, recruiter = doanh nghiệp
enum Side {
  seeker
  recruiter
}

model SavedJob {
  seekerId String
  jobId    String
  at       DateTime      @default(now())
  seeker   SeekerProfile @relation(fields: [seekerId], references: [userId], onDelete: Cascade)
  job      Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([seekerId, jobId])
}

enum MarkKind {
  saved
  skipped
}

/// Nhà tuyển dụng lưu / bỏ qua một ứng viên cho một tin
model CandidateMark {
  jobId    String
  seekerId String
  kind     MarkKind
  byUserId String
  at       DateTime      @default(now())
  job      Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker   SeekerProfile @relation(fields: [seekerId], references: [userId], onDelete: Cascade)
  by       User          @relation(fields: [byUserId], references: [id], onDelete: Cascade)

  @@id([jobId, seekerId, kind])
}

/// Một phía bày tỏ quan tâm (người tìm việc: ứng tuyển). Hai phía cùng có → Connection
model Interest {
  jobId         String
  seekerId      String
  from          Side
  at            DateTime      @default(now())
  /// Chỉ dùng cho đơn của người tìm việc: doanh nghiệp mở xem hồ sơ lần đầu
  viewedAt      DateTime?
  /// Chỉ dùng cho đơn của người tìm việc: doanh nghiệp bấm "Đang cân nhắc"
  consideringAt DateTime?
  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker        SeekerProfile @relation(fields: [seekerId], references: [userId], onDelete: Cascade)

  @@id([jobId, seekerId, from])
}

model Connection {
  jobId    String
  seekerId String
  at       DateTime      @default(now())
  job      Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker   SeekerProfile @relation(fields: [seekerId], references: [userId], onDelete: Cascade)

  @@id([jobId, seekerId])
}

model Message {
  id       String        @id @default(cuid())
  jobId    String
  seekerId String
  from     Side
  text     String
  /// Dòng hệ thống giữa khung chat (vd. "Đã gửi lời mời phỏng vấn")
  system   Boolean       @default(false)
  at       DateTime      @default(now())
  job      Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker   SeekerProfile @relation(fields: [seekerId], references: [userId], onDelete: Cascade)

  @@index([jobId, seekerId, at])
}

/// Mỗi tài khoản đọc tới đâu trong một cuộc trò chuyện (đếm tin chưa đọc)
model ConversationRead {
  userId   String
  jobId    String
  seekerId String
  lastRead DateTime
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  job      Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker   SeekerProfile @relation(fields: [seekerId], references: [userId], onDelete: Cascade)

  @@id([userId, jobId, seekerId])
}

enum InterviewMode {
  onsite
  online
}

enum InterviewStatus {
  pending
  confirmed
  declined
  cancelled
}

model Interview {
  id        String          @id @default(cuid())
  jobId     String
  seekerId  String
  /// 1–3 khung giờ doanh nghiệp đề xuất
  slots     DateTime[]
  chosen    DateTime?
  mode      InterviewMode
  place     String
  note      String?
  status    InterviewStatus @default(pending)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  job       Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker    SeekerProfile   @relation(fields: [seekerId], references: [userId], onDelete: Cascade)

  @@index([jobId, seekerId])
}

enum HireStatus {
  offered
  accepted
  declined
  withdrawn
  rejected
}

/// Mỗi cặp tối đa một bản ghi; trạng thái cuối thì không đổi nữa
model Hire {
  jobId     String
  seekerId  String
  status    HireStatus
  startDate DateTime?     @db.Date
  note      String?
  reason    String?
  at        DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  job       Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker    SeekerProfile @relation(fields: [seekerId], references: [userId], onDelete: Cascade)

  @@id([jobId, seekerId])
}

/// Đánh giá hai chiều sau khi đi làm; mỗi (cặp, phía viết) một lần, không sửa
model Review {
  jobId    String
  seekerId String
  from     Side
  stars    Int
  tags     String[]
  comment  String?
  at       DateTime      @default(now())
  job      Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker   SeekerProfile @relation(fields: [seekerId], references: [userId], onDelete: Cascade)

  @@id([jobId, seekerId, from])
}

enum NotificationKind {
  interest
  /// Doanh nghiệp đang cân nhắc đơn ứng tuyển
  considering
  connected
  interview_invited
  interview_confirmed
  interview_declined
  interview_cancelled
  offer
  offer_accepted
  offer_declined
  offer_withdrawn
  rejected
  review
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  jobId     String
  seekerId  String
  read      Boolean          @default(false)
  at        DateTime         @default(now())
  /// Đã xử lý gửi email lúc nào; null = chưa
  emailedAt DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker    SeekerProfile    @relation(fields: [seekerId], references: [userId], onDelete: Cascade)

  @@index([userId, read, at])
  @@index([emailedAt, at])
}

// ───────────────────────── Quản trị ─────────────────────────

enum ReportTarget {
  job
  company
  seeker
}

enum ReportStatus {
  open
  resolved
  dismissed
}

model Report {
  id         String       @id @default(cuid())
  target     ReportTarget
  targetId   String
  reason     String
  note       String?
  /// Người báo; null = khách chưa đăng nhập
  reporterId String?
  status     ReportStatus @default(open)
  resolution String?
  at         DateTime     @default(now())
  resolvedAt DateTime?
  reporter   User?        @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([status, at])
}

/// Một dòng duy nhất (id = 1)
model SystemConfig {
  id               Int      @id @default(1)
  /// Trọng số chấm điểm: { skills, schedule, salary, distance, jobType }
  weights          Json
  bannedWords      String[]
  minWageK         Int      @default(20)
  defaultRadiusKm  Int      @default(8)
  registrationOpen Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}
