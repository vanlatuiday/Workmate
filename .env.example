# Sao chép thành .env (không commit .env). Giá trị dưới đây khớp docker-compose.yml cho máy cá nhân.
DATABASE_URL="postgresql://workmate:workmate_dev@localhost:5432/workmate?schema=public"
PORT=8000
CORS_ORIGIN="http://localhost:5173"


# ── Kho lưu file (chuẩn S3). Trên máy: SeaweedFS trong docker-compose. Lên mạng: đổi sang R2/S3. ──
STORAGE_ENDPOINT="http://localhost:8333"
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY="workmate"
STORAGE_SECRET_KEY="workmate_dev_storage"
STORAGE_BUCKET_PUBLIC="workmate-public"
STORAGE_BUCKET_PRIVATE="workmate-private"
# Địa chỉ xem ảnh công khai
STORAGE_PUBLIC_URL="http://localhost:8333/workmate-public"

# ── Đăng nhập (JWT). Tạo chuỗi bí mật: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))" ──
JWT_SECRET="doi-thanh-chuoi-ngau-nhien-dai"
JWT_EXPIRES_IN="7d"
# production: không trả mã đặt lại mật khẩu về cho client, và kiểm tra đủ cấu hình lúc khởi động
NODE_ENV="development"

# ── Email (SMTP). Trên máy có thể bỏ trống: mã đặt lại mật khẩu hiện ngay trên trang. Production bắt buộc. ──
# Gửi bằng Gmail: bật Xác minh 2 bước cho tài khoản Google, tạo "Mật khẩu ứng dụng" ở
# https://myaccount.google.com/apppasswords rồi điền:
#   SMTP_HOST="smtp.gmail.com"   SMTP_PORT="587"   SMTP_SECURE="false"
#   SMTP_USER="ban@gmail.com"    SMTP_PASSWORD="<16 ký tự mật khẩu ứng dụng>"
#   SMTP_FROM="Workmate <ban@gmail.com>"   (Gmail chỉ cho gửi bằng chính địa chỉ này)
# Kiểm tra: MAIL_TEST_TO=ban@gmail.com npm run mail:test
SMTP_HOST=""
SMTP_PORT="587"
# true khi dùng cổng 465
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Workmate <no-reply@ten-mien-cua-ban.vn>"

# ── Số lớp proxy phía trước máy chủ (Cloudflare, Nginx, nền tảng host). Bỏ trống khi chạy trên máy. ──
TRUST_PROXY=""
